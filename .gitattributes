# Generated by the TanStack Router plugin on every dev run, always with LF.
# core.autocrlf=true was rewriting it to CRLF on checkout, so the file showed
# as modified permanently even when its contents had not changed — enough to
# block a rebase. Pinning the working-tree endings ends that churn.
web/src/routeTree.gen.ts text eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.pdf binary
*.db binary
