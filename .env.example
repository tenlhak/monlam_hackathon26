# MunSel configuration. Copy to .env for local development; on Railway set
# these as service variables instead.
#
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────

# Monlam AI. Powers the tutor's replies, the dictionary, text-to-speech,
# speech-to-text and OCR — nothing works without it.
# Create one in the Monlam AI Studio under API Keys (org OWNER/ADMIN).
MONLAMAI_STUDIO=

# OpenAI. GPT-4.1-mini orchestrates the tutor's lookups and drives the news
# agent. Without it the tutor falls back to answering from melong alone, which
# invents Tibetan vocabulary — see t_tutor/README.md.
OPENAI_API_KEY=


# ── Optional: tracing ───────────────────────────────────────────────────────

# LangSmith. Off unless LANGSMITH_TRACING is truthy AND a key is present.
# Tutor and news traffic share one project and are told apart by tags.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=munsel


# ── Optional: behaviour ─────────────────────────────────────────────────────

# Set to 0 to bypass the grounded agent and stream straight from melong.
# Useful for comparing the two; not recommended in production.
TUTOR_AGENT=1

# The model that decides which lookups to make. Routing is easy work, so the
# mini model is the default.
TUTOR_ORCHESTRATOR_MODEL=gpt-4.1-mini

# Whether the "Run the agent" button on the News tab is enabled. A run costs
# real money and takes minutes, and anyone who types a name is a user here, so
# set this to 0 before showing the app to more than a few people.
WATCH_ADMIN=1


# ── Deployment only ─────────────────────────────────────────────────────────

# Where the SQLite databases live. Leave unset locally: the files then stay in
# the working tree exactly where they already are. On Railway this is the mount
# path of the attached volume, without which every deploy wipes user accounts,
# chat history and placement results.
# DATA_DIR=/data

# PORT is injected by Railway; the Dockerfile falls back to 8080 locally.
